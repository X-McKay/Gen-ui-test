    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "eu_ai_act": {
          "$ref": "#/$defs/EuAiActAssessment"
        },
        "overall_risk_tier": {
          "$ref": "#/$defs/RiskTier",
          "default": "low"
        },
        "inherent_risk": {
          "$ref": "#/$defs/RiskProfile"
        },
        "residual_risk": {
          "$ref": "#/$defs/RiskProfile"
        },
        "risk_lenses": {
          "description": "Inherent and residual risk per enterprise lens, in a fixed order",
          "items": {
            "$ref": "#/$defs/RiskLens"
          },
          "title": "Risk Lenses",
          "type": "array"
        },
        "applicable_frameworks": {
          "items": {
            "type": "string"
          },
          "title": "Applicable Frameworks",
          "type": "array"
        },
        "obligations": {
          "items": {
            "$ref": "#/$defs/Obligation"
          },
          "title": "Obligations",
          "type": "array"
        },
        "recommended_next_steps": {
          "items": {
            "type": "string"
          },
          "title": "Recommended Next Steps",
          "type": "array"
        },
        "open_questions": {
          "description": "Dotted paths of fields left 'unknown'",
          "items": {
            "type": "string"
          },
          "title": "Open Questions",
          "type": "array"
        }
      },
      "title": "Assessment",
      "type": "object",
      "required": [
        "eu_ai_act",
        "overall_risk_tier",
        "inherent_risk",
        "residual_risk",
        "risk_lenses",
        "applicable_frameworks",
        "obligations",
        "recommended_next_steps",
        "open_questions"
      ]
    },
    "AutonomyLevel": {
      "enum": [
        "assistive",
        "recommends",
        "decides"
      ],
      "title": "AutonomyLevel",
      "type": "string"
    },
    "ControlEffect": {
      "additionalProperties": false,
      "description": "What one control did to the residual score, and why it did or did not count.",
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "control": {
          "description": "A ControlKind value, or the field name for an answer",
          "title": "Control",
          "type": "string"
        },
        "status": {
          "enum": [
            "applied",
            "unconfirmed",
            "absent",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "points": {
          "description": "Points removed from the inherent score",
          "minimum": 0,
          "title": "Points",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "field",
        "control",
        "status",
        "points",
        "text"
      ],
      "title": "ControlEffect",
      "type": "object"
    },
    "ControlKind": {
      "description": "Controls the owner can declare. ``NONE`` is an explicit \"none of these yet\".",
      "enum": [
        "guardrails",
        "access_controls",
        "pii_minimisation",
        "abuse_monitoring",
        "pre_release_evaluation",
        "vendor_data_protections",
        "incident_response",
        "user_disclosure",
        "none"
      ],
      "title": "ControlKind",
      "type": "string"
    },
    "Controls": {
      "additionalProperties": false,
      "description": "Mitigations already in place. Only confirmed controls lower the residual risk.",
