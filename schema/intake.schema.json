        "lifecycle_stage": {
          "$ref": "#/$defs/FieldMeta_LifecycleStage_"
        },
        "target_users": {
          "$ref": "#/$defs/FieldMeta_TargetUsers_"
        },
        "deployment_regions": {
          "$ref": "#/$defs/FieldMeta_list_str__"
        },
        "third_party_services": {
          "$ref": "#/$defs/FieldMeta_str_"
        }
