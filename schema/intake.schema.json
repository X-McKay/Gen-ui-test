          "$ref": "#/$defs/FieldMeta_bool_"
        },
        "autonomy_level": {
          "$ref": "#/$defs/FieldMeta_AutonomyLevel_"
        },
        "human_oversight": {
          "$ref": "#/$defs/FieldMeta_bool_"
        }
      },
      "title": "AiSystem",
      "type": "object",
      "required": [
        "uses_ai",
        "model_types",
        "model_source",
        "model_providers",
        "gpai_model_used",
        "fine_tuned_or_trained",
        "autonomy_level",
