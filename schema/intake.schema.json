      "required": [
        "name",
        "description",
        "owner",
        "team",
        "business_unit",
        "lifecycle_stage",
        "target_users",
        "deployment_regions",
        "third_party_services"
      ]
    },
    "RationaleEntry": {
      "additionalProperties": false,
      "description": "Why a classification was reached, linked to the answer that drove it.",
      "properties": {
        "field": {
          "description": "Dotted path of the field that triggered the rule",
          "title": "Field",
          "type": "string"
        },
        "value": {
          "description": "The value that triggered the rule",
          "title": "Value"
        },
        "article": {
          "description": "Citation, e.g. 'EU AI Act Art. 6(2), Annex III 4'",
          "title": "Article",
          "type": "string"
        },
        "text": {
          "description": "Plain-language explanation",
          "title": "Text",
          "type": "string"
        },
        "effect": {
          "description": "Classification effect, e.g. 'high_risk'",
          "title": "Effect",
          "type": "string"
        }
      },
      "required": [
        "field",
        "value",
        "article",
        "text",
        "effect"
      ],
      "title": "RationaleEntry",
      "type": "object"
    },
    "RiskDriver": {
      "additionalProperties": false,
      "description": "One answer that adds inherent risk, with the points it contributes.",
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "value": {
          "title": "Value"
        },
        "category": {
          "description": "exposure, autonomy, data or impact",
          "title": "Category",
          "type": "string"
        },
        "points": {
          "minimum": 0,
          "title": "Points",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "lenses": {
          "description": "Enterprise risk lenses this driver counts towards",
          "items": {
            "type": "string"
          },
          "title": "Lenses",
          "type": "array"
        }
      },
      "required": [
        "field",
        "value",
        "category",
        "points",
        "text",
        "lenses"
      ],
      "title": "RiskDriver",
      "type": "object"
    },
    "RiskLens": {
      "additionalProperties": false,
      "description": "One enterprise lens (data privacy, information security, operational, financial,\nreputational, regulatory) with its inherent and residual profile.",
      "properties": {
        "lens": {
          "title": "Lens",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "inherent": {
          "$ref": "#/$defs/RiskProfile"
        },
        "residual": {
          "$ref": "#/$defs/RiskProfile"
        }
      },
      "required": [
        "lens",
        "label",
        "inherent",
        "residual"
      ],
      "title": "RiskLens",
      "type": "object"
    },
    "RiskProfile": {
      "additionalProperties": false,
      "description": "Inherent risk (from the answers) or residual risk (after confirmed controls), for the\nwhole use case or for one enterprise risk lens.",
      "properties": {
        "lens": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None for the overall profile",
          "title": "Lens"
        },
        "tier": {
          "$ref": "#/$defs/RiskTier",
          "default": "low"
        },
        "score": {
          "default": 0,
          "title": "Score",
          "type": "integer"
        },
        "drivers": {
          "items": {
            "$ref": "#/$defs/RiskDriver"
          },
          "title": "Drivers",
          "type": "array"
        },
        "controls": {
          "items": {
            "$ref": "#/$defs/ControlEffect"
          },
          "title": "Controls",
          "type": "array"
        },
        "floor": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskTier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "floor_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor Reason"
        }
      },
      "title": "RiskProfile",
      "type": "object",
      "required": [
        "lens",
        "tier",
        "score",
        "drivers",
        "controls",
        "floor",
        "floor_reason"
      ]
    },
    "RiskTier": {
      "enum": [
