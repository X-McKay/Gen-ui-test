        },
        "emotion_recognition": {
          "$ref": "#/$defs/FieldMeta_bool_"
        },
        "social_scoring": {
          "$ref": "#/$defs/FieldMeta_bool_"
        },
        "remote_biometric_id_public_spaces": {
          "$ref": "#/$defs/FieldMeta_bool_"
        },
        "manipulative_or_subliminal": {
          "$ref": "#/$defs/FieldMeta_bool_"
        },
        "untargeted_facial_scraping": {
          "$ref": "#/$defs/FieldMeta_bool_"
        }
      },
      "title": "UseCase",
      "type": "object",
      "required": [
        "domains",
        "purpose",
        "affects_legal_or_significant_effects",
        "interacts_directly_with_people",
        "generates_synthetic_content",
        "emotion_recognition",
        "social_scoring",
        "remote_biometric_id_public_spaces",
        "manipulative_or_subliminal",
        "untargeted_facial_scraping"
      ]
    }
