# ---- Inference (default: live OpenAI-compatible endpoint) ---------------------------------
INFERENCE_PROVIDER=openai_compatible      # openai_compatible | bedrock
OPENAI_BASE_URL=https://llm.almckay.io/v1
OPENAI_API_KEY=                           # from your secret store; the dev endpoint accepts none
MODEL_ID=openai/Qwen3.6-35B-A3B-NVFP4     # openai/<id from GET /v1/models>
# INFERENCE_PROVIDER=bedrock
# MODEL_ID=bedrock/anthropic.claude-3-5-sonnet-20240620-v1:0
# AWS_REGION=eu-west-1                    # standard AWS credential chain, no keys here
INFERENCE_TIMEOUT_S=60
INFERENCE_MAX_RETRIES=2
MOCK_MODEL=0                              # 1 replays fixtures; CI and offline work only

# ---- Backend ------------------------------------------------------------------------------
ENVIRONMENT=development                   # development | test | production
LOG_LEVEL=INFO
LOG_AGUI_EVENTS=0
DATABASE_URL=sqlite:///./intake.db        # any SQLAlchemy URL, e.g. postgresql+psycopg://...
FRONTEND_ORIGIN=http://localhost:3000
AGENT_RATE_LIMIT=60/minute
AGENT_MAX_CONCURRENT_RUNS=200                 # open interviews (each rendered step holds a slot)
AGENT_EXECUTION_TIMEOUT_S=600             # a slot is reclaimed after this many idle seconds
DEFAULT_OWNER=                            # prefilled owner when no SSO header is present
INTAKE_WEBHOOK_URL=                       # Submit posts the JSON export here when set

# ---- Repository analysis ------------------------------------------------------------------
REPO_ALLOWED_HOSTS=["github.com","gitlab.com","dev.azure.com"]
REPO_ACCESS_TOKEN=                        # default token for private repositories
REPO_CLONE_TIMEOUT_S=120
REPO_MAX_SIZE_MB=200
REPO_MAX_FILES=20000

# ---- Frontend (frontend/.env.local) -------------------------------------------------------
BACKEND_URL=http://localhost:8000         # server-side only; the browser uses /api/backend
NEXT_PUBLIC_ENABLE_INSPECTOR=1            # CopilotKit Inspector outside production
COPILOTKIT_TELEMETRY_DISABLED=true        # keep the runtime from phoning home
